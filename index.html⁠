<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حيدر صباح | Haider Sabah</title>
    <!-- استيراد خط القاهرة -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <!-- استيراد أيقونات FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #0d0f12;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }

        /* خلفية جمالية شعاعية */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 20%, rgba(212, 160, 23, 0.15) 0%, transparent 60%);
            z-index: -1;
        }

        .container {
            width: 100%;
            max-width: 450px;
            text-align: center;
            background: rgba(20, 24, 33, 0.85);
            border: 1px solid rgba(212, 160, 23, 0.3);
            border-radius: 20px;
            padding: 30px 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(10px);
        }

        /* حاوية الصورة الشخصية والشعار */
        .profile-container {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 20px;
        }

        .profile-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #d4a017;
            box-shadow: 0 0 20px rgba(212, 160, 23, 0.4);
        }

        .logo-badge {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            border: 2px solid #ffffff;
            object-fit: cover;
            background: #000;
        }

        h1 {
            font-size: 24px;
            font-weight: 900;
            margin-bottom: 5px;
            color: #ffffff;
        }

        .bio-title {
            font-size: 14px;
            color: #d4a017;
            margin-bottom: 20px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        /* شاشة كلمة السر */
        .lock-screen {
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: rgba(13, 15, 18, 0.6);
            padding: 20px;
            border-radius: 15px;
            border: 1px dashed rgba(212, 160, 23, 0.4);
        }

        .lock-screen i {
            font-size: 28px;
            color: #d4a017;
            margin-bottom: 5px;
        }

        .password-input {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid rgba(212, 160, 23, 0.4);
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            text-align: center;
            font-size: 16px;
            outline: none;
            transition: 0.3s;
        }

        .password-input:focus {
            border-color: #d4a017;
            box-shadow: 0 0 10px rgba(212, 160, 23, 0.3);
        }

        .unlock-btn {
            background: #d4a017;
            color: #0d0f12;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

        .unlock-btn:hover {
            background: #f1b81a;
            transform: translateY(-2px);
        }

        .error-msg {
            color: #ff4d4d;
            font-size: 13px;
            display: none;
            margin-top: 5px;
        }

        /* قائمة الروابط (مخفية افتراضياً) */
        .links-list {
            display: none;
            flex-direction: column;
            gap: 15px;
            animation: fadeIn 0.5s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .link-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, rgba(212, 160, 23, 0.15) 0%, rgba(20, 24, 33, 0.9) 100%);
            border: 1px solid rgba(212, 160, 23, 0.4);
            border-radius: 12px;
            padding: 15px 20px;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .link-btn:hover {
            background: linear-gradient(135deg, rgba(212, 160, 23, 0.3) 0%, rgba(30, 36, 48, 0.9) 100%);
            border-color: #d4a017;
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(212, 160, 23, 0.3);
        }

        .link-btn i {
            font-size: 20px;
            color: #d4a017;
        }

        .link-btn span {
            flex-grow: 1;
            text-align: center;
        }

        .footer {
            margin-top: 30px;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.4);
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- الصورة الشخصية وشعار الحشد -->
        <div class="profile-container">
            <img src="myphoto.jpg" alt="حيدر صباح" class="profile-img">
            <img src="logo.png" alt="الشعار" class="logo-badge">
        </div>

        <!-- الاسم والعنوان -->
        <h1>حيدر صباح</h1>
        <div class="bio-title">Haider Sabah</div>

        <!-- قسم الحماية بكلمة السر -->
        <div class="lock-screen" id="lockScreen">
            <i class="fa-solid fa-lock"></i>
            <p style="font-size: 14px; color: #ccc;">أدخل كلمة السر لعرض الروابط</p>
            <input type="password" id="passInput" class="password-input" placeholder="كلمة السر...">
            <button onclick="checkPassword()" class="unlock-btn">دخول</button>
            <div id="errorMsg" class="error-msg">كلمة السر غير صحيحة!</div>
        </div>

        <!-- قائمة الروابط (تظهر بعد إدخال كلمة السر الصحيحة) -->
        <div class="links-list" id="linksList">
            <a href="https://instagram.com/6z_l_" target="_blank" class="link-btn">
                <i class="fa-brands fa-instagram" style="color: #E1306C;"></i>
                <span>انستغرام</span>
                <i class="fa-solid fa-chevron-left" style="font-size: 12px; opacity: 0.5;"></i>
            </a>

            <a href="https://facebook.com" target="_blank" class="link-btn">
                <i class="fa-brands fa-facebook" style="color: #1877F2;"></i>
                <span>فيسبوك</span>
                <i class="fa-solid fa-chevron-left" style="font-size: 12px; opacity: 0.5;"></i>
            </a>

            <a href="https://youtube.com" target="_blank" class="link-btn">
                <i class="fa-brands fa-youtube" style="color: #FF0000;"></i>
                <span>قناة اليوتيوب (Dreamy Days)</span>
                <i class="fa-solid fa-chevron-left" style="font-size: 12px; opacity: 0.5;"></i>
            </a>
        </div>

        <div class="footer">
            جميع الحقوق محفوظة © 2026
        </div>
    </div>

    <script>
        function checkPassword() {
            const input = document.getElementById('passInput').value;
            const correctPass = "2007/16/6";
            const lockScreen = document.getElementById('lockScreen');
            const linksList = document.getElementById('linksList');
            const errorMsg = document.getElementById('errorMsg');

            if (input === correctPass) {
                lockScreen.style.display = 'none';
                linksList.style.display = 'flex';
            } else {
                errorMsg.style.display = 'block';
            }
        }
    </script>
</body>
</html>
